# === KALSHI ===
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem
KALSHI_ENV=demo                    # demo | production

# === POLYMARKET (arbitraż) ===
POLYMARKET_API_KEY=
POLYMARKET_WALLET_ADDRESS=

# === AI ===
ANTHROPIC_API_KEY=

# === DANE ZEWNĘTRZNE ===
NOAA_API_KEY=                      # darmowy: api.weather.gov
FRED_API_KEY=                      # darmowy: fred.stlouisfed.org
ESPN_API_KEY=                      # darmowy tier dostępny
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
NEWS_API_KEY=                      # newsapi.org (darmowy tier)

# === MONITORING ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === SYSTEM ===
TRADING_MODE=paper                 # paper | live — zmień tylko świadomie!
STARTING_BANKROLL=1000             # USD
MAX_DAILY_LOSS_PCT=0.05            # 5% — bot się zatrzymuje
MAX_POSITION_PCT=0.03              # 3% bankrollu per zakład
LOG_LEVEL=INFO
