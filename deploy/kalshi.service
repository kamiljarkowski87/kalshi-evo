[Unit]
Description=Kalshi Evo Trading Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/claude-runner/kalshi-evo
Environment=PYTHONPATH=/home/claude-runner/kalshi-evo
ExecStart=/home/claude-runner/kalshi-evo/.venv/bin/python src/orchestrator.py
Restart=on-failure
RestartSec=30
StandardOutput=append:/home/claude-runner/kalshi-evo/logs/service.log
StandardError=append:/home/claude-runner/kalshi-evo/logs/service.log

[Install]
WantedBy=default.target
